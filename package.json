{
  "name": "ignoti-monorepo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "build": "pnpm -r --filter=./packages/* build",
    "dev:sdk": "pnpm --filter @ignoti/sdk dev",
    "dev:server": "pnpm --filter @ignoti/server dev",
    "dev:demo": "pnpm --filter @ignoti/demo dev",
    "dev:api": "pnpm --filter @ignoti/example-api dev",
    "test": "pnpm -r test",
    "lint": "biome check packages examples",
    "lint:fix": "biome check --write packages examples",
    "format": "biome format --write packages examples",
    "format:check": "biome format packages examples",
    "typecheck": "pnpm -r typecheck",
    "check": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "typescript": "^5.8.3"
  }
}
