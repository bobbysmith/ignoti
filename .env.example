# Environment for docker-compose.yml. Copy to .env and fill in the required values.

# Required. Hostname your frontend is served from: no scheme, no port.
RP_ID=localhost

# Required. Origin(s) your frontend is served from. Comma-separated for several.
RP_ORIGIN=http://localhost:5173

# Required. Public base URL of this server. Must equal the SDK's backendUrl.
PUBLIC_URL=http://localhost:8787

# Required. Secret your backend sends to POST /api/sessions/verify (the
# verifier's introspectionSecret). Generate with: openssl rand -base64 32
INTROSPECTION_SECRET=
# Still accepted while rotating to a new INTROSPECTION_SECRET.
# INTROSPECTION_SECRET_PREVIOUS=

# Must be true in any deployed environment. Set to false only for local
# development over plain HTTP.
COOKIE_SECURE=true

# Number of proxy hops in front of the server (1 = one load balancer), or
# false when clients connect directly.
TRUST_PROXY=false

# Optional. Defaults shown.
# RP_NAME=Ignoti
# CHALLENGE_TTL_SECONDS=300
# SESSION_TTL_SECONDS=86400
# GC_INTERVAL_SECONDS=3600
# LOG_LEVEL=info
