PORT=8787
HOST=0.0.0.0

# Postgres connection string.
DATABASE_URL=postgres://user:password@host:5432/dbname

# Set to false if your connection pooler does not support prepared statements.
DB_PREPARE=true

# WebAuthn relying party. RP_ID=your app's hostname
RP_ID=localhost
RP_NAME=GhostID
RP_ORIGIN=http://localhost:5173

CHALLENGE_TTL_SECONDS=300
SESSION_TTL_SECONDS=86400
LOG_LEVEL=info
