PORT=8787
HOST=0.0.0.0

# Postgres connection string.
DATABASE_URL=postgres://user:password@host:5432/dbname

# Set to false if your connection pooler does not support prepared statements.
DB_PREPARE=true

# WebAuthn relying party. RP_ID=your app's hostname
RP_ID=localhost
RP_NAME=GhostID
RP_ORIGIN=http://localhost:5173

CHALLENGE_TTL_SECONDS=300
SESSION_TTL_SECONDS=86400
LOG_LEVEL=info

# In-process garbage collection interval (seconds). Prunes expired challenges,
# nonces, and old sessions/devices. Set to 0 to disable if you schedule
# ghostid_gc() externally (pg_cron, Supabase Cron).
GC_INTERVAL_SECONDS=3600

# How much of X-Forwarded-For to trust when deriving the client IP for rate
# limiting. Integer = number of proxy hops (1 = one load balancer in front).
# 'false' = no proxy (use socket address). 'true' = trust the whole chain (only
# behind a proxy that strips client XFF). Or a comma-separated IP/CIDR allowlist.
TRUST_PROXY=1

# Set to false ONLY for local development over plain HTTP (localhost).
# Must be true in any deployed environment.
# COOKIE_SECURE=false
