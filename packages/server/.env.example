PORT=8787
HOST=0.0.0.0

# === DATABASE_URL ===
# Local Postgres:
#   postgres://postgres:postgres@localhost:5432/ghostid
#
# Supabase: Project Settings -> Database -> Connection string. Pick ONE:
#   - "Session" pooler  (port 5432)  ← use this for the GhostID server (long-lived)
#   - "Transaction" pooler (port 6543) ← only if you set DB_PREPARE=false
#   - "Direct" connection (port 5432, no pooler) ← also fine
# Always URL-encode special characters in your password.
DATABASE_URL=postgres://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Set to "false" if you're using the Supabase transaction pooler (port 6543).
# Otherwise leave true.
DB_PREPARE=true

# WebAuthn relying party. RP_ID = the demo's hostname (no scheme, no port).
RP_ID=localhost
RP_NAME=GhostID
RP_ORIGIN=http://localhost:5173

CHALLENGE_TTL_SECONDS=300
SESSION_TTL_SECONDS=86400
LOG_LEVEL=info
