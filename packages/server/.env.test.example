# Copy to .env.test.local (gitignored) before running `pnpm test:integration`.
# The integration suite TRUNCATEs every table, so it must point at a DEDICATED
# throwaway database. cleanDatabase() refuses to run unless the database name
# ends in "_test".
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ignoti_test

DB_PREPARE=true
RP_ID=localhost
RP_NAME=Ignoti
RP_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
RATE_LIMIT_DISABLED=true