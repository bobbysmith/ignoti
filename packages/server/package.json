{
  "name": "@ghostid/server",
  "version": "0.0.1",
  "description": "Self-hosted backend server for the GhostID authentication platform.",
  "type": "module",
  "private": true,
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file=.env.local src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx --env-file=.env.local src/db/migrate.ts",
    "test:integration": "node --env-file=.env.local node_modules/vitest/dist/cli.js run --config vitest.integration.config.ts",
    "test:integration:ci": "vitest run --config vitest.integration.config.ts",
    "db:migrate:ci": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.1",
    "@fastify/rate-limit": "^10.1.1",
    "@ghostid/shared": "workspace:*",
    "@simplewebauthn/server": "^11.0.0",
    "fastify": "^5.1.0",
    "jose": "^6.2.2",
    "postgres": "^3.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "@vitest/coverage-v8": "^3.2.4",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
